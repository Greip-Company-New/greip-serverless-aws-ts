      "name": "service-security / Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "channel",
                "value": "{{canal}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{ak-service-security}}"
              }
            ],
            "url": {
              "raw": "{{api-server}}/srv-security/auth/login",
              "host": [
                "{{api-server}}"
              ],
              "path": [
                "srv-security",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@greip.com.pe\",\n  \"password\": \"Greip#2026\"\n}"
            },
            "description": "Inicia sesión por email (o documentType + documentNumber). El canal se toma del header `Canal`. Guarda el accessToken en la variable `token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json().payload;",
                  "if (body && body.data && body.data.accessToken) {",
                  "  pm.collectionVariables.set('token', body.data.accessToken);",
                  "  console.log('Token guardado');",
                  "} else {",
                  "  console.log('Login sin accessToken (posible desafío MFA):', JSON.stringify(body));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
