{
  "name": "ly-nodejs-ts-common",
  "version": "1.0.0",
  "description": "Layer Common de GREIP COMPANY (adaptada de ly-nodejs-ts-common de AFP Siembra)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:@aws-sdk/* --external:@middy/* --external:aws-xray-sdk --external:aws4 --external:axios --external:body-parser --external:class-transformer --external:csvtojson --external:dayjs --external:email-validator --external:joi --external:json-2-csv --external:jsonpath-plus --external:jsonwebtoken --external:reflect-metadata --external:tslib --external:uuid --external:velocityjs",
    "package": "npm run build && mkdir -p nodejs && cp package.json nodejs/ && (cd nodejs && NODE_ENV=production npm install --omit=dev --omit=peer) && mkdir -p nodejs/node_modules/ly-nodejs-ts-common && cp package.json nodejs/node_modules/ly-nodejs-ts-common/ && cp -r dist nodejs/node_modules/ly-nodejs-ts-common/",
    "deploy": "bash deploy-layer.sh",
    "deploy:dev": "bash deploy-layer.sh devGreipCompany",
    "clean": "rm -rf dist nodejs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.540.0",
    "@middy/core": "^4.6.1",
    "aws-xray-sdk": "^3.12.0",
    "aws4": "^1.13.2",
    "axios": "^1.13.2",
    "body-parser": "^2.2.1",
    "class-transformer": "^0.5.1",
    "crypto-js": "^4.2.0",
    "csvtojson": "^2.0.14",
    "dayjs": "^1.11.19",
    "email-validator": "^2.0.4",
    "joi": "^17.13.3",
    "json-2-csv": "^5.5.10",
    "jsonpath-plus": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "uuid": "^9.0.1",
    "velocityjs": "^2.1.5"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.954.0",
    "@aws-sdk/client-dynamodb": "^3.540.0",
    "@aws-sdk/client-eventbridge": "^3.540.0",
    "@aws-sdk/client-iam": "^3.954.0",
    "@aws-sdk/client-lambda": "^3.540.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/client-secrets-manager": "^3.540.0",
    "@aws-sdk/client-sfn": "^3.540.0",
    "@aws-sdk/client-sns": "^3.540.0",
    "@aws-sdk/client-sqs": "^3.540.0",
    "@aws-sdk/client-ssm": "^3.540.0",
    "@aws-sdk/lib-dynamodb": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@aws-sdk/types": "^3.540.0",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/uuid": "^9.0.8",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "oracledb": "^6.10.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/client-eventbridge": "^3",
    "@aws-sdk/client-lambda": "^3",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-secrets-manager": "^3",
    "@aws-sdk/client-sfn": "^3",
    "@aws-sdk/client-sns": "^3",
    "@aws-sdk/client-sqs": "^3",
    "@aws-sdk/client-ssm": "^3",
    "aws-lambda": "^1.0.7"
  },
  "engines": {
    "node": ">=18.x"
  },
  "keywords": [],
  "author": "GREIP COMPANY",
  "license": "MIT"
}
