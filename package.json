{
  "name": "greip-serverless-aws-ts",
  "version": "1.0.0",
  "description": "Monorepo de microservicios AWS Lambda (Serverless Framework + TypeScript) de GREIP COMPANY",
  "scripts": {
    "build": "webpack",
    "deploy": "npm run build && serverless deploy",
    "lint": "eslint 'services/**/core/**/*.js'",
    "lint:fix": "eslint 'services/**/core/**/*.js' --fix",
    "format": "prettier --write '**/*.{js,yml,json}'",
    "prepare": "husky"
  },
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@serverless/compose": "^1.3.0",
    "eslint": "^8.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "^28.1.3",
    "prettier": "^2.7.1",
    "serverless": "^4.25.0",
    "serverless-offline": "^14.4.0",
    "standard": "^17.1.0"
  },
  "eslintConfig": {
    "extends": "standard"
  }
}
